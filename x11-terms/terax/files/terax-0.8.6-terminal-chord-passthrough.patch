+/**
+ * Chords that mean something to a terminal before they mean anything to us.
+ *
+ * MOD_PROP is Meta on macOS but Ctrl everywhere else, so each ⌘+<key> below
+ * becomes Ctrl+<key> on Linux/Windows — which is how a POSIX terminal encodes
+ * a control character. Ctrl+D is EOT, Ctrl+[ is ESC, Ctrl+I is TAB. While a
+ * terminal pane has focus App.tsx defers these ids, so the keystroke reaches
+ * the PTY instead of being swallowed by the app; everywhere else in the UI
+ * they keep working. This is the reasoning upstream already applied to Ctrl+B
+ * (see sidebar.toggle) and to ⌘K (see terminal.clear); it just has to cover
+ * every colliding chord, not one.
+ *
+ * Where a deferred id also carries an always-on chord, that chord is
+ * Ctrl+Shift+<letter>. It is the only class xterm.js leaves inert: its
+ * control-character branch requires !shiftKey, whereas Ctrl+Alt+<letter> is
+ * forwarded as ESC+<control char> — and readline binds precisely these
+ * letters (\e\C-d, \e\C-e, \e\C-f, \e\C-g, \e\C-i, \e\C-r, \e\C-t, \e\C-]),
+ * so Ctrl+Alt would relocate the bug rather than fix it. Ctrl+Shift+C and
+ * Ctrl+Shift+V are the terminal's own copy/paste and are equally unavailable.
+ */
+export const TERMINAL_RESERVED_CHORD_IDS: ReadonlySet<ShortcutId> =
+  new Set<ShortcutId>([
+    "commandPalette.open", // Ctrl+P — previous-history
+    "tab.new", // Ctrl+T — transpose-chars
+    "tab.newEditor", // Ctrl+E — end-of-line
+    "tab.newPrivate", // Ctrl+R — reverse-i-search
+    "tab.close", // Ctrl+W — kill-word-backward
+    "pane.splitRight", // Ctrl+D — EOT / end-of-file
+    "pane.focusPrev", // Ctrl+[ — ESC
+    "pane.focusNext", // Ctrl+] — GS
+    "pane.source", // Ctrl+G — abort
+    "search.focus", // Ctrl+F — forward-char
+    "ai.toggle", // Ctrl+I — TAB
+  ]);
+
