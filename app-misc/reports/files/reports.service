[Unit]
Description=Reports data collection service
After=network-online.target postgresql.service
Wants=network-online.target
# 30 starts within 12h cover the initial run plus 29 retries at 20-minute intervals.
# This covers the observed 13:50 to 22:10 day-ahead publication delay and expires
# before the next day's timer trigger.
StartLimitBurst=30
StartLimitIntervalSec=12h

[Service]
Type=oneshot
ExecStart=/usr/bin/reports fetch -v --config-file /etc/reports/config.toml --key-file /etc/reports/keys/.encryption_key
User=reports
Group=reports

# Retry while tomorrow's day-ahead prices are not yet published
Restart=on-failure
RestartSec=20min

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/reports

[Install]
WantedBy=multi-user.target
